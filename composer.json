{
    "name": "crustum/audit",
    "description": "Audit plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crustum",
        "audit"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.4",
        "crustum/plugin-manifest": "^1.0",
        "crustum/prompts": "^1.2",
        "laravel/agent-detector": "^2.0.2",
        "skie/signal_handler": "^1.0",
        "symfony/polyfill-php84": "^1.31",
        "symfony/process": "^7.4 || ^8.0",
        "composer/semver": "^3.4"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "^4.3",
        "pestphp/pest": "^4.1",
        "phpunit/phpunit": "^10.5 || ^11.1 || ^12.5",
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.2.2",
        "rector/rector": "^2.5",
        "cakephp/migrations": "^5.2",
        "cakephp/queue": "^2.3",
        "cakephp/bake": "^3.0",
        "boundwize/structarmed": "0.14"
    },
    "suggest": {
        "cakephp/migrations": "Enables pending-migration diagnostics.",
        "cakephp/queue": "Enables queue connection and asynchronous-mode diagnostics.",
        "crustum/cakephp-scheduling": "Enables scheduled-task registration diagnostics.",
        "ext-redis": "Enables diagnostics for Redis-backed cache and queue configurations."
    },
    "autoload": {
        "psr-4": {
            "Crustum\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\Audit\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline",
        "structarmed": "vendor/bin/structarmed analyze src"
    },
    "extra": {
        "installer-name": "Audit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
